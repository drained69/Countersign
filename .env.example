# All integrations are optional. Missing keys -> that tier runs in clearly-labelled MOCK mode.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
SERV_BASE_URL=https://inference-api.openserv.ai

# Reppo lite eval: credit token (x402ck_...) from POST /api/v1/x402/credits
REPPO_CREDIT_TOKEN=
# Set to true to call Reppo with the Sandbox header (free, placeholder verdicts)
REPPO_SANDBOX=false

# Kite: requires the kpass CLI installed and logged in, plus an active session
KITE_MODE=mock   # mock | kpass
PORT=8787
