# Demo: leave everything empty. Each missing integration runs a clearly-labelled MOCK stand-in.
# Real payments: see "Going live with real payments" in README.md, then run `npm run doctor`.

# --- Sponsor checks ---
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# SERV Reasoning graph features on the model ID (empty = plain SERV), and reasoning effort
SERV_FEATURES=kronos-multipath
SERV_REASONING_EFFORT=low
SERV_BASE_URL=https://inference-api.openserv.ai

# Reppo panel evaluations: an API key from eval.reppo.xyz (free sign-up credits),
# or a credit token (x402ck_...) bought with USDC on Base via POST /api/v1/x402/credits
REPPO_API_KEY=
REPPO_CREDIT_TOKEN=
# Optional: most live Reppo evaluations per UTC day (public demos)
REPPO_DAILY_LIMIT=

# --- Kite ---
# mock | kpass (real money: needs kpass 6.8.9+, `kpass login`, and an account allowance)
KITE_MODE=mock
# allowance (default) | session (then set KITE_SESSION_ID)
KITE_PAY_FROM=allowance
KITE_SESSION_ID=

# --- Access (required for KITE_MODE=kpass or a non-loopback HOST) ---
# Generate each with: openssl rand -hex 24
TRIPWIRE_OWNER_TOKEN=
# agentId:key,agentId:key
TRIPWIRE_AGENT_KEYS=

# --- Live setup ---
# Starting policy (copy policy.example.json)
POLICY_FILE=
# Slack-compatible webhook for "a payment needs you" alerts
NOTIFY_WEBHOOK_URL=
# Base URL for links in alerts, e.g. https://tripwire.yourdomain.com
PUBLIC_URL=

# Public demo (hosted): open dashboard, rate-limited. Never with KITE_MODE=kpass.
PUBLIC_DEMO=false
# Public LIVE (hosted): anyone can trigger one capped real payment and watch the feed; admin stays
# behind TRIPWIRE_OWNER_TOKEN. Needs KITE_MODE=kpass. Visitors spend the real Kite allowance (keep it small).
PUBLIC_LIVE=false
PUBLIC_RATE_LIMIT=40
TRUST_PROXY=false

PORT=8787
HOST=127.0.0.1
