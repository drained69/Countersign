{
  "name": "tripwire",
  "version": "1.0.0",
  "description": "Tiered co-signer for AI agent payments on Kite: code rules, SERV reasoning, a Reppo network verdict and a Kite passkey step-up, with a receipt for every decision.",
  "keywords": [
    "kite",
    "agent-payments",
    "x402",
    "openserv",
    "serv",
    "reppo",
    "mcp",
    "ai-agents",
    "security"
  ],
  "homepage": "https://github.com/drained69/Tripwire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drained69/Tripwire.git"
  },
  "bugs": {
    "url": "https://github.com/drained69/Tripwire/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo": "node scripts/demo.ts",
    "replay": "node scripts/replay.ts",
    "mcp": "node src/mcp.ts",
    "doctor": "node scripts/doctor.ts",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test",
    "serv:bench": "node scripts/serv-bench.ts"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "7.0.2"
  }
}
