{
  "name": "tripwire-video",
  "version": "1.0.0",
  "private": true,
  "description": "Product demo video for Tripwire, built with Remotion. Separate from the app, which has zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "audio": "node scripts/soundtrack.ts",
    "studio": "npm run audio && remotion studio src/index.ts",
    "stills": "node scripts/stills.ts",
    "render:wide": "remotion render src/index.ts Wide out/tripwire-demo-1920x1080.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --audio-bitrate=320k",
    "render:tall": "remotion render src/index.ts Tall out/tripwire-demo-1080x1920.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --audio-bitrate=320k",
    "render": "npm run audio && npm run render:wide && npm run render:tall",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
